# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

PORT=4001

# CORS — the origin(s) the calling app(s) are served from.
# Comma-separated if you need more than one (e.g. dev + prod, or multiple projects).
ALLOWED_ORIGIN=http://localhost:5200

# MySQL — the shared database this service's agents/call_logs tables live in
# (see schema.sql). May be the same database PSRI's contacts/cases live in,
# or a separate one — this service only ever writes to agents/call_logs.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SparkTG — one shared base URL, but a SEPARATE account per project (each
# process has its own svc-id + login). List every project this service
# should serve, comma-separated, then set that project's 3 variables below.
# Adding a new project (e.g. vmm) needs no code change — just add its name
# here and its SPARKTG_VMM_* variables.
TELEPHONY_PROJECTS=psri

SPARKTG_BASE_URL=https://telephonycloud.co.in

# PSRI — svc-id 1287. Any one of PSRI's working agent logins is enough;
# results are scoped by svc-id + call transaction id, not by which agent
# is authenticated.
SPARKTG_PSRI_SVC_ID=1287
SPARKTG_PSRI_USERNAME=
SPARKTG_PSRI_PASSWORD=

# VMM — uncomment and fill in when VMM is wired up, then add "vmm" to
# TELEPHONY_PROJECTS above. VMM's existing n8n workflows use svc-id 1672.
# SPARKTG_VMM_SVC_ID=1672
# SPARKTG_VMM_USERNAME=
# SPARKTG_VMM_PASSWORD=
